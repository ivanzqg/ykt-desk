{
  "manifest_version": 3,
  "name": "雨课堂学习台",
  "version": "1.1.0",
  "description": "查看课程、待办与视频进度，选择校园版或雨课堂版，管理最多16个视频的倍速与静音播放。",
  "minimum_chrome_version": "118",
  "permissions": ["debugger", "storage", "tabs"],
  "host_permissions": [
    "https://tsinghua.yuketang.cn/*",
    "https://pro.yuketang.cn/*"
  ],
  "background": {"service_worker": "service-worker.js", "type": "module"},
  "action": {"default_title": "打开雨课堂学习台"},
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'; frame-ancestors 'none'"
  }
}
